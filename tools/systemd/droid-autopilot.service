# Runs the autopilot loop on the bot machine (veritas) as a user service.
#
#   mkdir -p ~/.config/systemd/user
#   cp tools/systemd/droid-autopilot.service ~/.config/systemd/user/
#   # set WorkingDirectory to THIS checkout (not a stale second clone) and your ntfy topic, then:
#   systemctl --user daemon-reload
#   systemctl --user start droid-autopilot        # first run: watch it for one cycle
#   systemctl --user enable droid-autopilot      # make it survive a logout/reboot
#   loginctl enable-linger "$USER"               # keep running after you log out
#   journalctl --user -u droid-autopilot -f
#
# Stop gracefully after the current cycle:  touch data/autopilot/STOP
# Stop now:                                 systemctl --user stop droid-autopilot
#
# Paths are absolute on purpose: %h/droid-harness does not exist on veritas, and a second
# clone at ~/src/droid-harness is stale and has no .venv, so a relative path silently runs
# old code or fails in ExecStartPre. Keep this pointing at the one checkout that has data/.

[Unit]
Description=droid-harness autopilot (farm -> diagnose -> propose -> test -> promote -> report)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nick/Documents/Projects/active/droid-harness
Environment=PYTHONUNBUFFERED=1
# The phone must be on adb before the loop starts; fail fast (and retry) if it isn't.
ExecStartPre=/usr/bin/env adb wait-for-device
ExecStartPre=/home/nick/Documents/Projects/active/droid-harness/.venv/bin/droid-harness doctor --device phone-a --mode training_camp
ExecStart=/home/nick/Documents/Projects/active/droid-harness/.venv/bin/droid-harness autopilot \
    --device phone-a \
    --testbed training_camp --test dense \
    --cycles 0 --rest-s 120 \
    --notify-url https://ntfy.sh/droid-autopilot-8f3c1a7b6e2d4951 \
    --publish-git \
    --ui --ui-host 0.0.0.0
# --ui-host 0.0.0.0 makes the Studio reachable from your LAN (http://veritas:8765); drop it for localhost only.
Restart=on-failure
RestartSec=5min
# A cycle can run for hours; give it time to write its report on stop.
TimeoutStopSec=90

[Install]
WantedBy=default.target
